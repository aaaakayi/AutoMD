# ═══════════════════════════════════════════════════════════════════
# .gitignore for AutoMD
# ═══════════════════════════════════════════════════════════════════

# ── Python ─────────────────────────────────────────────────────────
# Caches
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# ── Secrets & local config ───────────────────────────────────────
.env
.env.*
!.env.example

# ── Editor / IDE / workspace ─────────────────────────────────────
**/.claude/
**/.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
*.rej

# ── OS noise ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Runtime artifacts (do NOT commit) ────────────────────────────
# Logs
*.log
log/

# Temp / scratch
temp/
tmp/

# AutoMD workflow output (large, per-session)
AutoMD_LangGraph/output/
output/                 # legacy top-level, in case it ever reappears

# Chat session persistence
data/sessions/

# LLM debug logs
log/chat_llm_context.jsonl

# ── Large local dependencies and downloaded bundles ──────────────
dock_tools/
memory/RAG/local_sbert_model/
models/
checkpoints/

# ── Node / JS (defensive — in case JS gets added later) ──────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ── Python notebook / data-science noise ─────────────────────────
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ── PyMOL sessions / temporary files ─────────────────────────────
*.pse
*.pse_
*.sdf.bak
